# Supabase: te vinden in het Supabase dashboard onder Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Publieke URL van de app, gebruikt voor redirects in auth e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key (service role) van Supabase, alleen voor de server: nodig om
# gebruikers uit te nodigen vanuit Instellingen. Nooit met NEXT_PUBLIC_ ervoor
# zetten en nooit delen. Te vinden onder Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Passkeys (WebAuthn). Standaard afgeleid van NEXT_PUBLIC_SITE_URL; alleen
# invullen als het portaal op een ander domein draait, bijvoorbeeld
# WEBAUTHN_RP_ID=portaal.nordavo.nl en WEBAUTHN_ORIGIN=https://portaal.nordavo.nl.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Ondertekent het cookie dat een passkey-sessie als tweestaps geverifieerd
# markeert. Leeg laten valt terug op SUPABASE_SECRET_KEY.
PASSKEY_SESSION_SECRET=

# ---------------------------------------------------------------------------
# GTM systeem. Alles hieronder is alleen voor de server en de geplande jobs.
# ---------------------------------------------------------------------------

# Claude API, voor kwalificatie, vacatures uitlezen, matchen en profielen, en voor
# screening: CV's lezen (PDF), CV's scoren tegen de JD en de talentpool vraag.
# Zonder sleutel werken DOCX en eenvoudige PDF's, de techstack check op trefwoorden
# en de CSV import gewoon; scoren en PDF's met ingesloten fonts wachten.
# Academy: AI-voorstel op de rubric bij opdrachten (alleen een voorstel, Nordavo
# beslist). Zonder sleutel beoordeelt Nordavo zonder voorstel.
ANTHROPIC_API_KEY=

# Beveiligt POST /api/jobs/<naam> voor een externe scheduler. De fallback jobs
# (S1 tot S4, S8) weigert hij: die draaien alleen met de hand.
# Ook voor de dagelijkse Academy job academy-task-reminders (achterstallige taken).
CRON_SECRET=

# Fallback jobs. Claude's geplande taken doen dit werk met eigen connectors
# (docs/claude-jobs.md); het portaal zelf heeft geen koppeling nodig. Vul deze
# sleutels alleen in als je de fallback jobs S1 tot S4 en S8 met de hand wilt
# kunnen draaien op Beheer, Jobs.
#
# Apify: vacatures en beslissers (S1, S3). Actor-id's in de vorm gebruiker~actor.
APIFY_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR=
APIFY_INDEED_JOBS_ACTOR=
APIFY_PEOPLE_ACTOR=

# Prospeo: mailadressen zoeken en verifiëren (S4).
PROSPEO_API_KEY=

# Instantly: replies, bounces en afmeldingen ophalen (S8).
INSTANTLY_API_KEY=

# Cal.com: geheim van de webhook naar /api/webhooks/calcom. Dezelfde webhook
# verwerkt de salesafspraken en de sollicitatiegesprekken (docs/recruitment-planning.md).
# Voor salesafspraken is de Cal.com taak van Claude de hoofdroute; de webhook is
# een extra ingang en maakt geen dubbele afspraak (zelfde booking uid);
# zet hem in het Cal.com account van elke interviewer met hetzelfde geheim.
CALCOM_WEBHOOK_SECRET=
# Cal.com link voor salesgesprekken (https). "Meeting planned" op het belscherm
# opent deze link met naam, mail en notitie van het contact ingevuld. Leeg: het
# eigen boekingslink van het ingelogde teamlid (Instellingen, Interviews);
# externe bellers hebben dan geen link (docs/calls.md).
NEXT_PUBLIC_CALCOM_SALES_URL=

# Fallback job s8-webpartners-import: de oude afsprakensheet van Web Partners
# lezen. Meetings en de Cal.com taak van Claude vervangen die sheet.
# Google service account (JSON op één regel); deel de sheet met zijn client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
WEBPARTNERS_APPOINTMENTS_SHEET_ID=

# Alle mail uit het portaal gaat via Resend, in de Nordavo huisstijl (docs/mail.md):
# foutmeldingen, het weekrapport, gesprekken, sollicitatieforms en Work. De
# afzenders moeten op een in Resend geverifieerd domein staan (DKIM en SPF).
# Testen: Instellingen, blok Email, Send test mail. Zonder sleutel krijg je de
# boekingslink in het portaal om zelf te versturen.
RESEND_API_KEY=
MAIL_FROM=Nordavo <systeem@nordavo.nl>
REPORT_EMAIL_TO=julius@nordavo.nl

# Werving, sollicitatieform (docs/recruitment-forms.md). Afzender van mail aan
# kandidaten (formlink en herinneringen), op een eigen domein zodat het niet
# het cold mail domein deelt. Leeg valt terug op MAIL_FROM.
MAIL_FROM_RECRUITMENT=Nordavo Talent <talent@nordavo.nl>
# Optioneel: standaard CC bij het versturen van het form, bijvoorbeeld floris@nordavo.nl.
FORMS_DEFAULT_CC=

# ---------------------------------------------------------------------------
# Work (takentool, docs/work.md). Gebruikt ook SUPABASE_SECRET_KEY, RESEND_API_KEY,
# MAIL_FROM en CRON_SECRET hierboven.
# ---------------------------------------------------------------------------

# Eenmalige import uit ClickUp: persoonlijk API token (ClickUp > Settings > Apps).
CLICKUP_API_TOKEN=
# Optioneel: ClickUp workspace id naar Work slug, bijvoorbeeld {"9012345":"nordavo","9012346":"kg"}.
CLICKUP_IMPORT_MAP=

# ---------------------------------------------------------------------------
# Nordavo Academy (docs/academy.md)
# ---------------------------------------------------------------------------

# Cal.com link (https) voor "Plan een call met Nordavo" op de startpagina van
# de Academy. Leeg: het boekingslink van de Nordavo contactpersoon van de
# plaatsing (Instellingen, Interviews); zonder beide geen knop.
# Mensen toevoegen met een nieuw account gebruikt SUPABASE_SECRET_KEY (hierboven),
# de uitnodiging gaat via RESEND_API_KEY.
NEXT_PUBLIC_ACADEMY_BOOKING_URL=
